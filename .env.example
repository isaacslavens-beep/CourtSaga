# Every setting CourtSaga reads. For local development copy this to .env.local (never committed) and fill
# it in; for the live site set the same names in Vercel (Project → Settings → Environment Variables).

# Postgres on Neon. Connecting Neon from the Vercel Marketplace sets both in Vercel for you.
# DATABASE_URL is the pooled connection the site uses. DATABASE_URL_UNPOOLED is the direct connection that
# migrations (npm run db:migrate) and the match import (npm run import:matches) use.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# Better Auth. A random secret, 32 characters or more: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's address. Production: https://www.courtsaga.com
# Leave it unset on Vercel previews; they use their own address.
BETTER_AUTH_URL=http://localhost:3000
