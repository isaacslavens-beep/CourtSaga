# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# the match data: imported from a local folder, never committed (its licence is non-commercial)
*.csv
*.zip

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent skills the Vercel CLI installs alongside integrations
/.agents/
/.claude/skills/
/skills-lock.json
